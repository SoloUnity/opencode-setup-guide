{
  "$schema": "https://opencode.ai/config.json",
    "mcp": {
    "servers": {
      "tool-gateway": {
        "type": "remote",
        "url": "https://tool-gateway.shopify.io/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:TOOL_GATEWAY_TOKEN}"
        }
      },
      "craft": {
        "type": "remote",
        "url": "https://mcp.craft.do/my/mcp",
        "disabled": true
      }
    }
  },
  "plugins": [
    "./plugins/oh-my-opencode-slim",
    "./plugins/agent-order/plugin"
  ],
  "agents": {
    "build": {
      "color": "#10B981",
      "permissions": [
        {
          "action": "subagent",
          "resource": "explorer",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "librarian",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "oracle",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "designer",
          "effect": "deny"
