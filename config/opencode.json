          "action": "task_*",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "wait_for_user",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "acp_run",
          "resource": "*",
          "effect": "deny"
