{
  "$schema": "https://opencode.ai/v2/cli.json",
  "plugins": [
    "./plugins/herdr-opencode",
    {
      "package": "./plugins/herdr-subagent-panes",
      "options": {
        "mainPaneWidthPercent": 60,
        "commandPrefix": [
          "devx"
        ]
      }
    }
  ],
  "keybinds": {
    "agent.cycle": "tab",
    "agent.cycle.reverse": "shift+tab"
  },
  "prompt": {
    "image_preview": true
  },
  "session": {
    "thinking": "show"
  },
  "mini": {
    "thinking": "show",
    "work_spinner": "block-soft-slide"
  }
}
